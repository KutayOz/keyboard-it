import { LineEdit, Button, CheckBox, VerticalBox, HorizontalBox, GroupBox, AboutSlint } from "std-widgets.slint";

// Small settings window — opened from the tray via "Settings...", the app outlives closing it.
// There is nothing to type here any more: the Mac finds this PC over the network and the
// pairing key is handed over automatically once the user approves the request.
export component SettingsWindow inherits Window {
    title: "keyboard-it";
    preferred-width: 380px;
    preferred-height: 340px;

    in property <bool> active;                 // listener state (ACTIVE/INACTIVE)
    in property <string> this-pc;              // "This PC: HOSTNAME — 192.168.1.x" (from Rust)
    in-out property <string> listen-port;
    in-out property <bool> autostart;
    in property <string> status-line;          // info/error message from Rust

    callback start-listener();
    callback stop-listener();
    callback save();
    callback autostart-changed(bool);
    callback forget-devices();

    VerticalBox {
        padding: 12px;
        spacing: 8px;

        Text {
            text: root.active ? "● ACTIVE — listening on " + root.listen-port : "○ INACTIVE — stopped";
            color: root.active ? #2e7d32 : #b71c1c;
            font-size: 15px;
            font-weight: 700;
        }

        // Identity line: which PC the user should be looking for in the Mac's list.
        Text { text: root.this-pc; font-size: 12px; }

        GroupBox {
            title: "Pairing";
            VerticalBox {
                spacing: 6px;
                Text {
                    text: "On the Mac, open Settings, pick this PC and click Pair. A confirmation with a 6-digit code appears here.";
                    font-size: 12px;
                    wrap: word-wrap;
                }
                Button {
                    text: "Forget paired Macs";
                    clicked => { root.forget-devices(); }
                }
                Text {
                    text: "Creates a new key, so every paired Mac has to pair again.";
                    font-size: 11px;
                    color: #808080;
                    wrap: word-wrap;
                }
            }
        }

        GroupBox {
            title: "Settings";
            VerticalBox {
                spacing: 6px;
                Text { text: "Listening port"; }
                LineEdit { placeholder-text: "5599"; text <=> root.listen-port; }
                CheckBox {
                    text: "Start automatically at logon (elevated)";
                    checked <=> root.autostart;
                    toggled => { root.autostart-changed(self.checked); }
                }
            }
        }

        HorizontalBox {
            spacing: 8px;
            Button {
                text: root.active ? "Stop" : "Start";
                clicked => {
                    if (root.active) { root.stop-listener(); } else { root.start-listener(); }
                }
            }
            Button { text: "Save"; clicked => { root.save(); } }
        }

        Text { text: root.status-line; color: #808080; font-size: 12px; wrap: word-wrap; }

        Rectangle { vertical-stretch: 1; }
        AboutSlint { }
    }
}

// Pairing confirmation. This single click is what authenticates the whole channel:
// the pairing transport is encrypted but unauthenticated, and the code is derived from
// the handshake hash, so a man in the middle cannot make both screens agree. Shown
// on demand from Rust and always on top — it must not get lost behind other windows.
export component PairRequestWindow inherits Window {
    title: "keyboard-it — pairing request";
    preferred-width: 340px;
    preferred-height: 250px;
    // min-* is load-bearing, not belt-and-braces. With preferred-* alone this window
    // opened at 178x261 on Windows 11 (measured): narrow enough that both paragraphs
    // wrapped onto extra lines, so the content grew taller than the frame and the
    // Allow/Deny row landed ~23px BELOW the bottom edge. The dialog looked fine and was
    // impossible to answer — the only reachable affordances were the title-bar X and the
    // 60s timeout, and both of those decline. The height carries slack on purpose so a
    // 64-byte peer name wrapping to two or three lines still cannot push the buttons out.
    min-width: 360px;
    min-height: 340px;
    always-on-top: true;

    in property <string> peer-name;
    in property <string> code;        // pre-formatted "482 913"

    callback allow();
    callback deny();

    VerticalBox {
        padding: 16px;
        spacing: 10px;

        Text {
            text: "Allow this Mac to control this PC?";
            font-size: 15px;
            font-weight: 700;
            wrap: word-wrap;
        }
        Text { text: root.peer-name; font-size: 13px; wrap: word-wrap; }

        Rectangle {
            height: 56px;
            background: #f0f0f0;
            border-radius: 6px;
            Text {
                text: root.code;
                font-size: 26px;
                font-weight: 700;
                letter-spacing: 2px;
            }
        }

        Text {
            text: "Allow only if the Mac shows the same code. Whoever you allow can type and click on this PC.";
            font-size: 11px;
            color: #808080;
            wrap: word-wrap;
        }

        HorizontalBox {
            spacing: 8px;
            Button { text: "Deny"; clicked => { root.deny(); } }
            Button { text: "Allow"; primary: true; clicked => { root.allow(); } }
        }
    }
}

// System tray icon (Slint 1.17 native SystemTrayIcon → Shell_NotifyIconW).
// Parity with the Mac menu bar: state visible at a glance — the icon, tooltip and the
// "Status:" menu line change live with the connection state (Menu is reactive).
export component Tray inherits SystemTrayIcon {
    in property <bool> active;
    // Connection state (from Rust serve::ConnStatus): 0 waiting, 1 connected, 2 key mismatch.
    in property <int> conn: 0;

    // Status text from a single source: the tooltip and the menu line use the same wording.
    property <string> status-text: !root.active ? "Stopped"
        : root.conn == 1 ? "Connected"
        : root.conn == 2 ? "Key mismatch"
        : "Waiting for connection";

    // tray-on/err/off.png = tray.png + green/red dot / grayscale.
    icon: !root.active ? @image-url("tray-off.png")
        : root.conn == 1 ? @image-url("tray-on.png")
        : root.conn == 2 ? @image-url("tray-err.png")
        : @image-url("tray.png");
    tooltip: root.active ? "keyboard-it — ACTIVE — " + root.status-text : "keyboard-it — INACTIVE";

    callback show-settings();
    callback toggle-listener();
    callback quit();

    Menu {
        MenuItem {
            title: "Status: " + root.status-text;
            enabled: false; // non-clickable info line
        }
        MenuSeparator { }
        MenuItem {
            title: root.active ? "Stop" : "Start";
            activated => { root.toggle-listener(); }
        }
        MenuItem {
            title: "Settings...";
            activated => { root.show-settings(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "Quit";
            activated => { root.quit(); }
        }
    }
}
